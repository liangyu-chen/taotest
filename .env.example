# ===== 排班排程系統設定 =====
# 複製本檔為 .env 並填入下列值

# 伺服器埠號（預設 3001）
PORT=3001

# JWT 密鑰：請改成一長串隨機文字
JWT_SECRET=change-this-to-a-long-random-string

# Neon (PostgreSQL) 連接字串（系統唯一的儲存後端，必填）
# 在 Neon 專案 → Connect → Connection string 取得。
# 格式：postgresql://user:password@host/database?sslmode=verify-full
DATABASE_URL=

# 首次啟動自動建立的最高權限管理員（請於第一次登入後立刻修改密碼）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
