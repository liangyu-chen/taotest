# ===== 排班排程系統設定 =====
# 複製本檔為 .env 並填入下列值

# 伺服器埠號（預設 3001）
PORT=3001

# JWT 密鑰：請改成一長串隨機文字
JWT_SECRET=change-this-to-a-long-random-string

# Google 試算表 ID（在試算表網址中，介於 /d/ 與 /edit 之間的那段字串）
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id

# Google 服務帳號憑證檔名（本機使用，放在專案根目錄）
GOOGLE_CREDENTIALS_FILE=service-account.json

# Google 服務帳號憑證（雲端部署用）：
#   本機 → 使用上面的檔案即可，此變數留空
#   雲端部署（Render 等）→ 無法放檔案，直接把整份憑證 JSON 內容貼到下面的變數
GOOGLE_SERVICE_ACCOUNT_JSON=

# 首次啟動自動建立的最高權限管理員（請於第一次登入後立刻修改密碼）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
